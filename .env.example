# Example environment file for Hangug Deulama frontend.
# Copy this file to .env and set the values for your deployment.
#
# VITE_API_BASE_URL — base URL of the PHP backend.
#   - Leave blank/unset for same-origin deployments where the API lives
#     at `/api/...` on the current host.
#   - Set to e.g. `http://localhost/hangug-api/public` during local dev
#     when the API runs on a different virtual host than the SPA.

VITE_API_BASE_URL=